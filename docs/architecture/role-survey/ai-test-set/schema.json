{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidjobs.local/role-survey/ai-test-set/brief.schema.json",
  "title": "AidJobs Phase 5 AI test brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["brief_id", "family_id", "organisation_type", "level", "language", "duties", "requirements"],
  "properties": {
    "brief_id": { "type": "string", "minLength": 3, "maxLength": 32 },
    "family_id": { "type": "string" },
    "source_code": { "type": "string" },
    "quartile": { "type": "string" },
    "title": { "type": "string", "maxLength": 200 },
    "organisation_type": { "type": "string" },
    "level": { "type": "string" },
    "context": { "type": "array", "items": { "type": "string" } },
    "place": { "type": ["string", "null"] },
    "contract": { "type": ["string", "null"] },
    "contract_length": { "type": ["string", "null"] },
    "pay": { "type": ["string", "null"] },
    "closing_date": { "type": ["string", "null"] },
    "languages": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "reporting_line": { "type": ["string", "null"] },
    "team": { "type": ["string", "null"] },
    "budget": { "type": ["string", "null"] },
    "duties": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "description": "AidJobs-owned units, at most 12 words each"
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 }
    },
    "facts_missing": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string", "enum": ["en", "fr"] }
  }
}
