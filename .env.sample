# AidJobs environment variables — names only. Never put real values in this file.
# Real values live in Render (backend), Vercel (frontend), and your local apps/backend/.env
# and apps/frontend/.env.local, which git ignores.

# ---------------------------------------------------------------------------
# Backend (apps/backend, deployed on Render)
# ---------------------------------------------------------------------------

# Required
SUPABASE_DB_URL=           # PostgreSQL connection string (Supabase pooler); the only database setting used for queries
ADMIN_PASSWORD=            # admin login; without it, admin login is refused
COOKIE_SECRET=             # signs admin session tokens
AIDJOBS_ENV=production     # "production" in deployments; "dev" locally (local error details, test-friendly defaults)

# Optional
INTERNAL_API_KEY=          # enables the internal pipeline API (app/pipeline_api.py); unset means that API refuses calls
AIDJOBS_CORS_ORIGINS=      # extra browser origins, comma-separated; aidjobs.app, www.aidjobs.app, and localhost are always allowed
OPENROUTER_API_KEY=        # AI extraction; unset means crawls run without AI
OPENROUTER_MODEL=
AIDJOBS_DISABLE_SCHEDULER= # "true" stops scheduled crawls in this process
AIDJOBS_CRAWLER_UA=        # crawler User-Agent
AIDJOBS_CONTACT_EMAIL=     # contact address in the crawler User-Agent

# Optional search engine. Search always runs on the database; Meilisearch is not used today.
MEILISEARCH_URL=
MEILISEARCH_KEY=

# Dormant extraction rollout settings (progress ledger, W-23); leave unset unless that work resumes
# EXTRACTION_USE_NEW_EXTRACTOR=
# EXTRACTION_ROLLOUT_PERCENT=
# EXTRACTION_SHADOW_MODE=
# EXTRACTION_DOMAIN_ALLOWLIST=

# ---------------------------------------------------------------------------
# Frontend (apps/frontend, deployed on Vercel)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=        # backend origin, for example the Render service address
NEXT_PUBLIC_SITE_URL=       # public site address; defaults to https://aid-jobs-frontend.vercel.app
NEXT_PUBLIC_SITE_INDEXABLE= # "true" lets search engines index the site; anything else keeps "do not index"
